rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Subscriptions collection rules
    match /subscriptions/{subscriptionId} {
      // Allow read, update, delete only if the logged-in user matches document userId
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow create only if the created document's userId matches the requesting user's UID
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // User settings collection rules
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
